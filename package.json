{
  "name": "vr-therapy-backend",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.js",
  "scripts": {
    "test": "jest --runInBand",
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate:session-status": "node scripts/migrateSessionStatus.js",
    "seed:environments": "node scripts/seedEnvironments.js",
    "seed:therapist": "node scripts/seedStaff.js --role=therapist",
    "seed:admin": "node scripts/seedStaff.js --role=admin",
    "seed:scenarios": "node scripts/seedScenarios.js",
    "seed:devices": "node scripts/seedDevices.js",
    "seed:cloud": "node scripts/seedCloud.js",
    "simulate": "node scripts/simulate-devices.js",
    "simulate:watch": "node scripts/simulate-devices.js --only=watch",
    "test:coverage": "jest --runInBand --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.3.3",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "./tests/setup.js"
    ],
    "testTimeout": 30000,
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "setupFiles": [
      "./tests/env.js"
    ]
  }
}
