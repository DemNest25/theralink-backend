# ─── TheraLink backend ───────────────────────────────────────────────────────
# El mismo código corre en local (laptop + hotspot) y en la nube (Render + Atlas):
# solo cambian estas variables. Copia este archivo a .env para trabajar en local.
# En Render se llenan en el dashboard (ver docs/DEPLOY.md), no en un archivo.

# "production" en Render (lo fija render.yaml). En local se deja sin definir.
# NODE_ENV=production

# Puerto HTTP. Render lo inyecta solo; en local 3000. Siempre escucha en 0.0.0.0.
PORT=3000

# Base de datos. Local: MongoDB de la laptop. Nube: URI de Atlas (mongodb+srv://…).
# Si falta, en local usa mongodb://localhost:27017/vr-therapy; en producción el
# servidor no arranca. (El nombre anterior, MONGO_URI, se sigue aceptando.)
MONGODB_URI=mongodb://localhost:27017/vr-therapy

# Secreto para firmar los JWT. Obligatorio en producción (sin él no arranca).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Vigencia de los tokens (default 12h)
JWT_EXPIRES_IN=12h

# Orígenes de navegador permitidos, separados por comas (Express y Socket.io usan
# la misma lista). Quest, reloj y Postman no envían Origin y siempre pasan.
# Local: si se deja vacío se permiten localhost:5173/5174 y el hotspot
#        (http://192.168.137.1:5173 y :5174). "*" permite cualquiera.
# Nube:  la URL de la web en Render, sin barra final. Ej.: https://theralink-web.onrender.com
CORS_ORIGINS=

# Simulador de dispositivos (npm run simulate), solo desarrollo
SIM_QUEST_KEY=
SIM_WATCH_KEY=

# ─── Solo para npm run seed:cloud ────────────────────────────────────────────
# No va aquí: crea .env.cloud (ignorado por git) con la URI de Atlas:
#   MONGODB_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/theralink
