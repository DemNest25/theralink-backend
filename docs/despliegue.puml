@startuml despliegue
title TheraLink — Diagrama de despliegue (nube)

skinparam shadowing false
skinparam defaultFontName Arial
skinparam node {
  BackgroundColor #EDEFFB
  BorderColor #5A5E8C
}
skinparam database {
  BackgroundColor #E0F5EE
  BorderColor #1F6B52
}
skinparam artifact {
  BackgroundColor #FFFFFF
  BorderColor #8C8FB8
}

node "Computadora del terapeuta" <<device>> as pcTerapeuta {
  artifact "Navegador web\n(panel del terapeuta)" as navTerapeuta
}

node "Teléfono o computadora del paciente" <<device>> as pcPaciente {
  artifact "Navegador web\n(portal del paciente)" as navPaciente
}

node "Meta Quest 3S" <<device>> as quest {
  artifact "TheraLink VR\n(Unreal Engine 5 + VaRestX)" as visor
}

node "Samsung Galaxy Watch 6" <<device>> as reloj {
  artifact "TheraLink Watch\n(Wear OS, Kotlin)" as appReloj
}

cloud "Render — región Virginia (us-east)" as render {
  node "Static Site (CDN)" <<executionEnvironment>> as staticSite {
    artifact "theralink-web\n(React + Vite, archivos estáticos)" as web
  }
  node "Web Service (Node.js)" <<executionEnvironment>> as webService {
    artifact "vr-therapy-backend\nExpress (API REST) + Socket.io" as backend
  }
}

cloud "MongoDB Atlas — AWS us-east-1" as atlas {
  database "Cluster M0\nbase de datos theralink" as mongo
}

navTerapeuta --> web : HTTPS\n(carga de la aplicación)
navPaciente --> web : HTTPS\n(carga de la aplicación)

navTerapeuta --> backend : HTTPS — API REST (JSON, JWT)
navTerapeuta <--> backend : WSS — Socket.io\n(estado de sesión, biométricos y comandos en tiempo real)
navPaciente --> backend : HTTPS — API REST (JSON, JWT)

visor --> backend : HTTPS — polling cada 1–3 s\nGET comandos / PATCH confirmación\n(cabecera x-device-key)
appReloj --> backend : HTTPS — lotes de biométricos cada 5 s\nPOST /api/biometrics\n(cabecera x-device-key)

backend --> mongo : MongoDB Wire Protocol sobre TLS\n(mongodb+srv, puerto 27017)

note bottom of webService
  Health check: GET /health
  Plan Free: se suspende tras 15 min sin tráfico
  (Starter en días de prueba y defensa)
end note

note bottom of reloj
  Sensores: frecuencia cardiaca, EDA
  y temperatura de la piel
  (Samsung Health Sensor SDK)
end note

note as planB
  **Modo local (plan B):** los mismos componentes en una laptop
  (backend + MongoDB + web) con el Quest y el reloj conectados a su
  hotspot por HTTP. Se cambia con variables de entorno, la variante
  de build del reloj y el APK local del visor, sin cambiar la lógica.
end note
@enduml
